# Shareable planning template. These variable names are PROPOSED, not a verified
# ARGUS configuration API. No source or environment loader is present yet.
# Copy to .env for local use; never commit populated secrets or machine paths.

# Optional Anthropic planner credential. Leave empty if not using the planner.
ANTHROPIC_API_KEY=
# Select a supported model only after checking the eventual implementation.
ANTHROPIC_MODEL=

# Proposed portable resource locations; none of these resources are included.
ARGUS_DATA_DIR=./data
ARGUS_DVR_WEIGHTS_DIR=./weights/dvr
ARGUS_ADASTRA_DIR=./data/adastra
ARGUS_JASPAR_DIR=./data/jaspar
ARGUS_ENCODE_CCRE_DIR=./data/encode_ccre
ARGUS_RESULTS_DIR=./results

# Standalone cross-reference only; this does not enable loop integration.
ARGUS_ALPHAGENOME_ATLAS_DIR=./data/alphagenome_atlas
