# Shareable planning template. These names are PROPOSED, not a verified ARGUS
# configuration API. No source or environment loader is present in this checkout.
# Copy to .env for local use; never commit populated secrets or machine paths.

# Anthropic is used by the optional LLM planner and by the prose reporter.
# A rule-based planner run may still require this credential for prose reporting.
# Leave empty in this template.
ANTHROPIC_API_KEY=
# Proposed separate settings for the two distinct Anthropic roles.
# Choose supported model identifiers only after checking the implementation.
ARGUS_PLANNER_MODEL=
ARGUS_REPORTER_MODEL=

# Proposed portable resource locations; resources are not included.
ARGUS_DATA_DIR=./data
ARGUS_DVR_WEIGHTS_DIR=./weights/dvr
# Some investigation runs start from supplied/precomputed DVR probabilities.
ARGUS_DVR_PREDICTIONS_DIR=./data/dvr_predictions
ARGUS_ADASTRA_DIR=./data/adastra
ARGUS_JASPAR_DIR=./data/jaspar
ARGUS_ENCODE_CCRE_DIR=./data/encode_ccre
ARGUS_RESULTS_DIR=./results

# Standalone computational comparison only; does not enable loop integration.
ARGUS_ALPHAGENOME_ATLAS_DIR=./data/alphagenome_atlas
